{
  "name": "survival-spend",
  "version": "1.9.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "release": "standard-version",
    "make:logs": "node -e \"require('fs').mkdirSync('logs', { recursive: true })\"",
    "log": "npm run make:logs && git log --oneline > logs/historial.txt",
    "diff": "npm run make:logs && git diff HEAD > logs/diff.patch"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.30",
    "expo-constants": "~18.0.12",
    "expo-linking": "~8.0.11",
    "expo-modules-core": "~3.0.29",
    "expo-router": "~6.0.21",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
